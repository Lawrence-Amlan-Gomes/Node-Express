# Real .env files (git-ignored by this project's root .gitignore) hold
# secrets and per-environment values — never commit a real one.
#
# PG_SCHEMA is this mini-project's own dedicated schema — kept fully
# separate from every other mini-project already sharing this same real
# Postgres server (including the two Prisma-based Metaora mini-projects
# right next to this one).
DATABASE_URL="postgres://user:password@host:5432/postgres"
PG_SCHEMA="node_express_learning_metaora_join"
