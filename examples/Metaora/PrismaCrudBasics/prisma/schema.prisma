// This is the schema.prisma file for the "PrismaCrudBasics" mini-project.
// What this file does: declares the two real, related tables Metaora's own
// interview snippet uses — a Business that can have many Leads, and a Lead
// that belongs to exactly one Business.
generator client {
  provider = "prisma-client-js" // Tells Prisma to build a real, typed client into node_modules
}

datasource db {
  provider = "postgresql" // This mini-project talks to a real PostgreSQL server
  url      = env("DATABASE_URL") // The real connection string lives in .env, never here
}

// A real "Business" table.
model Business {
  id    Int    @id @default(autoincrement()) // A real auto-incrementing whole-number primary key
  name  String // A real, required plain-text name
  leads Lead[] // The OTHER side of the relation below — every Lead that points at this Business
}

// A real "Lead" table — a business's incoming customer contact, exactly
// the shape Metaora's own snippet works with.
model Lead {
  id         Int      @id @default(autoincrement()) // A real auto-incrementing whole-number primary key
  name       String // A real, required plain-text name
  phone      String // A real, required plain-text phone number
  status     String   @default("new") // "new" | "missed_call" | "contacted" | "recovered" — a real default of "new"
  businessId Int // The real foreign key column — which Business this Lead belongs to
  business   Business @relation(fields: [businessId], references: [id]) // The real relation Prisma's own "include" reads from
}
