# Real .env files (git-ignored by this project's root .gitignore) hold
# secrets and per-environment values — never commit a real one.
#
# The "?schema=" part of the URL is this mini-project's own dedicated
# schema — kept fully separate from every other mini-project already
# sharing this same real Postgres server (including
# AsyncRouteErrorHandling's own separate schema, right next to this one).
DATABASE_URL="postgres://user:password@host:5432/postgres?schema=node_express_learning_metaora_leads"
