# Real .env files (git-ignored by this project's root .gitignore) hold
# secrets and per-environment values — never commit a real one. This
# .env.example documents what's needed, with a placeholder value, so a
# teammate cloning the repo knows exactly what to put in their own .env.
#
# The "?schema=" part of the URL is this mini-project's own dedicated
# schema — kept fully separate from every other mini-project already
# sharing this same real Postgres server.
DATABASE_URL="postgres://user:password@host:5432/postgres?schema=node_express_learning_metaora_async"
